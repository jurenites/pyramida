extends SceneTree
const Game=preload("res://scripts/settlement/settlement.gd")
const Fixture=preload("res://tests/settlement/room_construction_test.gd")
const Rooms=preload("res://scripts/settlement/room_construction.gd")
var failures:=0
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var game=Game.new(); game.launch_to_menu=false; game.slot_directory="/tmp/pyramida-room-editor-test"
	root.add_child(game); game.set_process(false)
	game.model=Fixture.fixture(); game.model.room_site={}; game.world.sync(game.model,0,-1)
	var editor=game.room_editor; editor.sync(); editor.set_active(true)
	check(editor.active and editor.palette.visible,"Room editor opens inside the actual settlement scene")
	editor.pick_shape("cube"); editor.anchor=Vector3i.ZERO; editor.update_preview()
	check(editor.preview.get("ok",false) and game.model.room_site.is_empty(),"First room previews and validates without creating a site")
	check(editor.commit() and game.model.plans.size()==1 and game.model.room_site.built.is_empty(),"Editor click queues a worker job rather than creating a finished room")
	editor.sync()
	check(editor.view.scale==Vector3.ONE*2,"Shared room meshes use the confirmed 2 m module scale")
	editor.pick_shape("cube"); editor.anchor=Vector3i.RIGHT; check(editor.commit(),"Adjacent hall can be planned")
	editor.cancel(); editor.select(0); check(editor.scope=="building" and editor.ids==[0,1],"Editor selects whole building before a floor")
	editor.select(0); check(editor.scope=="floor","Second click selects floor")
	editor.begin_edit("copy"); check(editor.anchor.y==1 and editor.preview.ok,"Copy lifts the selected floor by one 2 m storey")
	check(editor.commit() and game.model.room_site.design.size()==4,"Floor copy creates separate material-backed construction plans")
	editor.sync(); editor.select(0); editor.select(0); editor.select(0)
	editor.begin_edit("move"); editor.anchor=Vector3i(0,0,5)
	check(not editor.commit(),"Moving a supporting lower plan cannot strand a planned upper floor")
	editor.cancel(); editor.pick_shape("room_domino"); editor.anchor=Vector3i.ZERO; editor.yaw=1
	check(editor.commit(),"Unstarted frame plans can be infilled directly by a room plan")
	check(game.model.room_site.design.size()==3,"Only covered hall plans are replaced")
	editor.pick_shape("bed"); editor.anchor=Vector3i.ZERO; editor.update_preview()
	var count: int=editor.view.get_child_count()
	for i in 5: editor.update_preview()
	check(editor.view.get_child_count()==count,"Bed hover does not accumulate stray preview meshes")
	check(editor.commit(),"Bed placement uses the settlement job queue")
	editor.sync()
	var geometry=editor.view.get_child(0)
	game.model.revision+=1; editor.sync()
	check(is_instance_valid(geometry) and geometry==editor.view.get_child(0),"Inventory revisions do not recreate room geometry")
	var design=Rooms.layout(game.model)
	var bedroom: Dictionary=design.rooms.filter(func(room):return room.shape=="room_domino")[0]
	design.rooms.erase(bedroom)
	check(not Rooms.commit(game.model,design),"Removing a planned bedroom cannot orphan its queued bed")
	check(not game.hud.status_label.is_visible_in_tree(),"Integration keeps persistent bottom instructions hidden")
	game.free()
	print("PASS: Settlement room editor" if failures==0 else "FAIL: Settlement room editor: %d failures" % failures)
	quit(1 if failures else 0)
