extends SceneTree
const Model = preload("res://scripts/settlement/world_model.gd")
func _initialize() -> void:
	var world = Model.new()
	world.setup()
	world.trees.clear()
	world.deposits.clear()
	world.water_sources.clear()
	world.rebuild_navigation()
	var cell := Vector3i(0, 0, -6)
	for tier in [1, 2, 3]:
		assert(world.request_build("stone_storage", cell, 1), world.last_message)
		var plan: Dictionary = world.plans[world.next_plan_id - 1]
		assert(plan.storage_tier == tier)
		world._complete_plan(plan)
		assert(world.stores[cell].capacity == (32 if tier == 1 else 64))
		if tier == 1: world.stores[cell].store("stone", 16)
		assert(world.stores[cell].count("stone") == 16)
		assert(world.navigation.access_cells(cell).size() == (1 if tier == 3 else 4))
		for support in world.stone_storage_cells(cell + Vector3i.UP * 2): assert(world.supports_build_cell(support))
		assert(world.build_error("house", cell + Vector3i.UP * 2).is_empty())
		assert(not world.build_error("house", cell + Vector3i(2, 0, 0)).is_empty())
		assert(world.Economy.accepts(world, cell, "stone"))
		assert(not world.Economy.accepts(world, cell, "log"))
		var restored = Model.new()
		assert(restored.restore(JSON.parse_string(JSON.stringify(world.snapshot()))))
		assert(restored.buildings[cell].storage_tier == tier)
		assert(restored.stores[cell].count("stone") == 16)
	assert(not world.request_build("stone_storage", cell))
	assert(world.construction_materials[cell] == {"log": 8, "plank": 12})
	print("PASS: stone storage tiers, capacity, retained inventory, access, roof support, footprint and saves")
	quit()
