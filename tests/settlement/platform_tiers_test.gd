extends SceneTree
const Model = preload("res://scripts/settlement/world_model.gd")
const Tiers = preload("res://scripts/settlement/platform_tiers.gd")
func _initialize() -> void:
	var world = Model.new()
	world.setup()
	world.trees.clear()
	world.deposits.clear()
	world.water_sources.clear()
	world.buildings.clear()
	world.stores.clear()
	world.gardens.clear()
	world.wells.clear()
	world.rebuild_navigation()
	var lower := Vector3i(0, 1, 0)
	var upper := Vector3i(0, 2, 0)
	assert(world.snap_cell("platform", "ground", Vector3i.ZERO) == lower)
	assert(world.request_build("platform", lower), world.last_message)
	world._complete_plan(world.plans[world.next_plan_id - 1])
	assert(world.platforms[lower] == 1)
	assert(world.navigation.surfaces.has(lower))
	assert(world.snap_cell("platform", "platform", lower) == upper)
	assert(world.request_build("platform", upper), world.last_message)
	world._complete_plan(world.plans[world.next_plan_id - 1])
	assert(not world.platforms.has(lower) and world.platforms[upper] == 2)
	assert(not world.navigation.surfaces.has(lower) and world.navigation.surfaces.has(upper))
	assert(world.construction_materials[upper].log == 8)
	assert(not world.construction_materials.has(lower))
	assert(world.platform_posts_overlap("house", Vector3i.ZERO))
	var restored = Model.new()
	assert(restored.restore(JSON.parse_string(JSON.stringify(world.snapshot()))))
	assert(restored.platforms[upper] == 2 and not restored.platforms.has(lower))
	assert(Tiers.tier(true) == 2)
	world.platforms[Vector3i(6, 2, 0)] = true
	var legacy = Model.new()
	assert(legacy.restore(JSON.parse_string(JSON.stringify(world.snapshot()))))
	assert(Tiers.tier(legacy.platforms[Vector3i(6, 2, 0)]) == 2)
	assert(world.snap_cell("platform", "ground", Vector3i(6, 0, 0), 2) == Vector3i(6, 2, 0))
	assert(not world.work_cells("platform", Vector3i(10, 2, 0), 0, 2).is_empty())
	var safe = Model.new()
	safe.setup()
	safe.platforms[lower] = 1
	safe.workers[0].cell = lower
	assert(not Tiers.merge_error(safe, upper).is_empty())

	var asset = load("res://data/settlement/platform.tscn").instantiate()
	var foot: MeshInstance3D = asset.get_node("StoneFoot")
	assert(is_equal_approx(foot.position.y + foot.scale.y * foot.get_aabb().position.y, -1))
	Tiers.sync(asset, 2)
	assert(is_equal_approx(foot.position.y + foot.scale.y * foot.get_aabb().position.y, -2))
	Tiers.sync(asset, 1)
	assert(is_equal_approx(foot.position.y + foot.scale.y * foot.get_aabb().position.y, -1))
	asset.free()
	print("PASS: tier 1 placement, automatic tier 2 merge, single deck, materials, clearance, saves and visual heights")
	quit()
