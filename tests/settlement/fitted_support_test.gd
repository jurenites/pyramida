extends SceneTree
const Model = preload("res://scripts/settlement/world_model.gd")
const Assembly = preload("res://scripts/settlement/support_assembly.gd")
const Runtime = preload("res://scripts/settlement/support_runtime.gd")
const Fixture = preload("res://tests/settlement/reviewed_balance_test.gd")
const View = preload("res://scripts/settlement/world_view.gd")
var failures: Array[String]=[]
func check(ok: bool,message: String) -> void:
	if not ok: failures.append(message); printerr("FAIL: "+message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var solver := Assembly.new()
	solver.add(Vector3.ZERO,0,0); solver.add(Vector3(1.05,0,0.03),deg_to_rad(5),1)
	var fitted := solver.layouts()
	check(fitted[0].posts==[true,true,true,true],"Older rotated-pair owner keeps all original posts")
	check(fitted[1].posts.count(false)==2,"Five-degree neighbor borrows two nearby posts")
	for index in [0,3]:
		var at: Vector3 = solver.supports[1]+solver.basis(1)*fitted[1].corners[index]
		check(absf(at.x-0.38)<0.001,"New rotated bearing meets the old log in world space")
	check(Assembly.overlaps(Vector3.ZERO,0,Vector3.RIGHT,deg_to_rad(8)),"Rotation overlap is detected even when grid boxes only touch")
	check(not Assembly.overlaps(Vector3.ZERO,0,Vector3(1.1,0,0),deg_to_rad(8)),"Slight translation provides real corner clearance")
	var fixture := Fixture.new(); var world = fixture.fixture()
	check(world.request_build("support",Vector3i(2,0,2)),"Main-game Support queues")
	check(world.debug_finish_plan(world.next_plan_id-1),"Existing building completes")
	var old: Dictionary = world.buildings[Vector3i(2,0,2)].duplicate(true)
	check(world.request_build("support",Vector3i(3,0,2),0,Vector3(0.08,0,0.03),true,deg_to_rad(5)),"Slightly rotated off-grid neighbor queues through real construction")
	check(world.debug_finish_plan(world.next_plan_id-1),"Rotated building completes")
	check(world.buildings[Vector3i(2,0,2)]==old,"Adding rotated neighbor never changes existing building data")
	check(world.buildings[Vector3i(2,0,2)].support_group!=world.buildings[Vector3i(3,0,2)].support_group,"Rotated buildings retain distinct identities")
	check(Runtime.carries_neighbor(world,Vector3i(2,0,2)),"Shared-log owner protects dependent neighbor")
	check(not world.Relocation.source_error(world,Vector3i(2,0,2)).is_empty(),"Cannot dismantle a borrowed bearing")
	check(not world.navigation._touching(Vector3i(2,1,2),Vector3i(3,1,2)),"Shared posts do not create a walking route across a deck gap")
	var view := View.new(); root.add_child(view); view.setup(world)
	var node: Node3D = view.entity_views["building:%s"%Vector3i(3,0,2)]
	check(is_equal_approx(node.rotation.y,deg_to_rad(5)),"Completed world model retains actual yaw")
	check(node.get_node("ConnectedStructure").find_children("Post*","MeshInstance3D",false,false).size()==2,"Actual rendered newer frame has only unshared legs")
	var collider: StaticBody3D = node.get_meta("collider")
	check(collider.get_child(0).shape is ConcavePolygonShape3D,"Picking uses fitted timber instead of a solid bounding box")
	check(world.request_build("support",Vector3i(3,1,2),0,Vector3(0.08,0,0.03),true,deg_to_rad(5)),"Rotated upper frame rests on the actual lower footprint")
	check(world.debug_finish_plan(world.next_plan_id-1),"Rotated stack completes with real footing checks")
	var saved: Variant = JSON.parse_string(JSON.stringify(world.snapshot()))
	var restored = Model.new(); check(restored.restore(saved),"Yaw, fine position, groups and priority save/load")
	check(is_equal_approx(restored.buildings[Vector3i(3,0,2)].support_yaw,deg_to_rad(5)),"Restore preserves exact angle")
	check(Runtime.carries_neighbor(restored,Vector3i(2,0,2)),"Restore preserves bearing ownership")
	check(not Runtime.valid({"support_yaw":NAN}),"Non-finite saved angles rejected")
	check(not world.request_build("support",Vector3i(5,0,2),0,Vector3.ZERO,true,PI/2),"Unsupported large rotation rejected")
	view.free(); fixture.free()
	if failures.is_empty(): print("PASS: rotated fitting, main-game construction, ownership, collider, navigation and save/load")
	quit(int(not failures.is_empty()))
