extends SceneTree
const Model = preload("res://scripts/settlement/world_model.gd")
const Barn = preload("res://scripts/settlement/hay_barn_view.gd")
func _initialize() -> void:
	for direction in 4:
		var world = Model.new()
		world.setup()
		world.trees.clear()
		world.deposits.clear()
		world.water_sources.clear()
		world.rebuild_navigation()
		var first := Vector3i(0, 0, -6)
		var second := first + Barn.join_step(direction)
		assert(is_equal_approx(world.navigation.point(first).distance_to(world.navigation.point(second)), 1.0))
		assert(world.request_build("hay_barn", first, direction), world.last_message)
		world._complete_plan(world.plans[world.next_plan_id - 1])
		assert(world.request_build("hay_barn", second, direction), world.last_message)
		world._complete_plan(world.plans[world.next_plan_id - 1])
		assert(world.buildings[second].direction == direction)
		var a = load("res://data/settlement/hay_barn.tscn").instantiate()
		var b = load("res://data/settlement/hay_barn.tscn").instantiate()
		Barn.sync(world, first, a)
		Barn.sync(world, second, b)
		assert(a.get_node("JoinPostFront").visible and b.get_node("JoinPostFront").visible)
		assert(a.get_node("SeamRafter0").visible and b.get_node("SeamRafter0").visible)
		var restored = Model.new()
		assert(restored.restore(JSON.parse_string(JSON.stringify(world.snapshot()))))
		assert(restored.buildings[second].direction == direction)
		world.buildings.erase(second)
		Barn.sync(world, first, a)
		assert(a.get_node("JoinPostFront").visible and a.get_node("SeamRafter0").visible)
		a.free()
		b.free()
	print("PASS: narrow hay barns retain all four chosen orientations, retain their authored posts and rafters before and after neighbour removal")
	quit()
