extends SceneTree
const Fixture = preload("res://tests/settlement/reviewed_balance_test.gd")
const Tiers = preload("res://scripts/settlement/house_tiers.gd")
const View = preload("res://scripts/settlement/world_view.gd")
const HUD = preload("res://scripts/settlement/hud.gd")
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var fixture := Fixture.new(); var model = fixture.fixture(); var cell := Vector3i.ZERO
	fixture.finish(model, "house", cell)
	assert(Tiers.tier(model.buildings[cell]) == 1)
	assert(not model.supports_build_cell(cell + Vector3i.UP * 2))
	assert(not model.request_build("house", cell + Vector3i.UP * 2), "Hay House must be reinforced before stacking")
	var stock = model.stores.get(cell)
	var before: Dictionary = model.buildings[cell].duplicate(true)
	var view := View.new(); root.add_child(view); view.setup(model)
	var hud := HUD.new(); root.add_child(hud); hud.update(model, -1, 0, {"kind": "house", "cell": cell})
	assert(hud.upgrade_button.visible)
	for level in [2, 3]:
		assert(model.request_build("house", cell))
		assert(not model.request_build("house", cell), "No duplicate upgrade")
		var plan: Dictionary = model.plans.values().back()
		assert(plan.materials == Tiers.cost(level) and plan.materials.size() <= 2)
		assert(model.Planning.ready(model, plan), "Upgrade is workable on the existing occupied footprint")
		assert(not model.Relocation.source_error(model, cell).is_empty(), "Upgrading House cannot be moved")
		model.Houses.price_plan(model, plan)
		assert(plan.materials == Tiers.cost(level), "Neighbour construction cannot reprice an upgrade")
		fixture.save_roundtrip(model)
		view.sync(model, 0, -1)
		assert(view.entity_views.has("building:%s" % cell), "Occupied House remains visible while upgrading")
		plan.used = plan.materials.duplicate(); plan.installed = plan.required
		model._complete_plan(plan)
		assert(Tiers.tier(model.buildings[cell]) == level and model.buildings[cell].direction == before.direction)
		assert(model.stores.get(cell) == stock, "Upgrade preserves household supplies")
		assert(model.supports_build_cell(cell + Vector3i.UP * 2))
		view.sync(model, 0, -1)
		var house: Node3D = view.entity_views["building:%s" % cell]
		assert(house.has_node("TierFrame") and house.get_node("TierFrame").visible)
		fixture.save_roundtrip(model)
	assert(not model.request_build("house", cell), "Three-tier limit")
	assert(Tiers.tier({"kind": "house"}) == 3, "Legacy houses retain structural support")
	assert(model.request_build("house", cell + Vector3i.UP * 2), "Upper House can now be constructed")
	var other = fixture.fixture()
	fixture.finish(other, "house", cell)
	assert(other.request_build("house", cell))
	var cancelled: Dictionary = other.plans.values().back()
	cancelled.used = {"log": 1}; cancelled.installed = 1
	assert(other.delete_plan(cancelled.id))
	assert(Tiers.tier(other.buildings[cell]) == 1 and other.Deconstruction.is_salvage(other.plans[cancelled.id]))
	fixture.save_roundtrip(other)
	var working = fixture.fixture()
	working.unlock_production("sawmill")
	fixture.finish(working, "house", cell)
	fixture.finish(working, "log_shed", Vector3i(4, 0, 0))
	working.stores[Vector3i(4, 0, 0)].store("log", 2)
	working.stores[Vector3i(4, 0, 0)].store("plank", 4)
	working.workers[0].role = "builder"; working.workers[0].cell = Vector3i(0, 0, 2); working.workers[0].position = Vector3(0, 0, 2)
	assert(working.request_build("house", cell))
	for step in 3500:
		fixture.step(working)
		if Tiers.tier(working.buildings[cell]) == 2: break
	assert(Tiers.tier(working.buildings[cell]) == 2, "A citizen delivers and installs the full paid upgrade")
	assert(working.stores[Vector3i(4, 0, 0)].count("log") == 0 and working.stores[Vector3i(4, 0, 0)].count("plank") == 0)
	assert(working.Relocation.request(working, cell, Vector3i(-4, 0, 0), 0, Vector3.ZERO))
	var move: Dictionary = working.plans.values().back()
	assert(move.house_tier == 2, "Relocation preserves paid tier")
	fixture.save_roundtrip(working)
	assert(fixture.failures.is_empty())
	view.queue_free(); hud.queue_free(); fixture.free(); await process_frame
	print("PASS: paid House upgrades, stacking, household preservation, limit and save/load")
	quit()
