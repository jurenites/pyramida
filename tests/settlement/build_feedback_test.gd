extends SceneTree
const Fixture=preload("res://tests/settlement/home_assembly_test.gd")
const HUD=preload("res://scripts/settlement/hud.gd")
const Tooltip=preload("res://scripts/settlement/object_tooltip.gd")
var failures:=0
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; printerr("FAIL: "+message)
func _initialize() -> void: call_deferred("run")
func run() -> void:
	var world=Fixture.fixture()
	for x in [0,2,4]:
		assert(world.request_build("house",Vector3i(x,0,0),1))
		world._complete_plan(world.plans.values()[0])
	var hud=HUD.new(); root.add_child(hud)
	hud.update(world,-1,1,{})
	check(hud.idle_count.text=="2/3","Existing population and three built places")
	hud.set_housing_preview(world,1)
	check(hud.idle_count.text=="2/4" and world.Economy.capacity(world)==3,"Preview adds one place without changing actual capacity")
	check(hud.housing_pulse!=null,"Changed capacity pulses")
	var pulse=hud.housing_pulse
	hud.set_housing_preview(world,1)
	check(hud.housing_pulse==pulse,"Steady hover does not restart animation")
	hud.set_housing_preview(world,0)
	check(hud.idle_count.text=="2/3","Leaving valid placement restores capacity")
	assert(world.request_build("house",Vector3i(6,0,0),1))
	hud.update(world,-1,1,{})
	check(hud.idle_count.text=="2/4" and "1 planned" in hud.population_tooltip,"Placed plan retains forecast and identifies planned places")
	assert(world.delete_plan(world.plans.keys()[0]))
	hud.update(world,-1,1,{})
	check(hud.idle_count.text=="2/3","Cancellation removes forecast")
	assert(world.request_build("house",Vector3i(6,0,0),1))
	world._complete_plan(world.plans.values()[0]); hud.update(world,-1,1,{})
	check(hud.idle_count.text=="2/4" and hud.idle_count.get_theme_color("font_color")==Color.BLACK,"Completion confirms four built places")
	assert(world.request_build("house",Vector3i.ZERO))
	hud.update(world,-1,1,{})
	check(hud.idle_count.text=="2/4","Reinforcement does not invent residents or capacity")
	world.Hydrology.populate(world,{Vector3i(0,0,6):"puddle"})
	var tip=Tooltip.new(); root.add_child(tip)
	for i in 3:
		var cell=Vector3i(i*2,0,6)
		assert(world.request_build("well",cell))
		world._complete_plan(world.plans.values().filter(func(p):return p.kind=="well")[0])
		var info=Tooltip.describe(world,{"kind":"well","cell":cell})
		check(info.rows.size()==1 and info.hover_rows==info.rows,"One water count with no rain-rate line")
		tip.show_info(info,false)
		check(tip.rows.visible and tip.rows.get_child_count()==1,"Well hover has one water row")
		check(tip.rows.get_child(0).get_child(1).get_theme_color("font_color")==Color("352719"),"Hover yield has readable dark ink")
	hud.free(); tip.free()
	print("PASS: housing preview, placement, cancellation, completion, upgrades and compact well counts" if failures==0 else "FAIL: build feedback")
	quit(failures)
