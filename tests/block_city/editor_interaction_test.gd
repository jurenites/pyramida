extends SceneTree
const Editor=preload("res://scripts/block_city/editor_selection.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func run() -> void:
	root.size=Vector2i(1100,760)
	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	for y in 2:
		for x in 2:
			game.model.queue[0]={"shape":"cube","color":0}
			check(game.model.drop(x,0,0,false,y),"Place fixture")
	game.refresh()
	check(not game.holding and game.ghost.get_child_count()==0,"Editor opens with an empty hand")
	var original: Dictionary=game.model.snapshot()
	var screen: Vector2=game.camera.unproject_position(Vector3(0.5,1.5,0.05))
	game.click_world(screen)
	check(game.selection_kind=="building" and game.selection_ids==[0,1,2,3] and not game.holding,"First click selects the whole building without moving it")
	check(game.editor_bar.visible and game.model.snapshot()==original,"Toolbar appears without changing construction")
	game.click_world(screen)
	check(game.selection_kind=="floor" and game.selection_ids==[2,3],"Second click selects the clicked floor")
	game.click_world(screen)
	check(game.selection_kind=="room" and game.selection_ids==[2],"Third click selects the room")
	var shift_click:=InputEventMouseButton.new(); shift_click.button_index=MOUSE_BUTTON_LEFT; shift_click.pressed=true; shift_click.shift_pressed=true
	shift_click.position=game.camera.unproject_position(Vector3(1.5,1.5,0.05))
	game._unhandled_input(shift_click)
	check(game.selection_kind=="multi" and game.selection_ids==[2,3],"Shift adds a room to the selection")
	var group_key:=InputEventKey.new(); group_key.keycode=KEY_G; group_key.meta_pressed=true; group_key.pressed=true
	game._input(group_key)
	check(game.selection_kind=="group" and game.model.rooms[2].groups==game.model.rooms[3].groups,"Command G creates a saved group")
	var grouped: Dictionary=game.model.snapshot()
	game.choose_scope(0)
	check(game.selection_kind=="building","Breadcrumb selects an ancestor")
	game.click_world(screen); game.click_world(screen)
	check(game.selection_kind=="group","Drilling down visits the group before the room")
	game.editor_bar.get_child(1).pressed.emit()
	check(game.holding and game.edit_action=="copy" and game.preview.ok and game.preview.origin.y==2,"Copy previews the whole group immediately above its source")
	check(game.ghost.get_children().filter(func(node):return str(node.name).begins_with("EditRoom")).size()==2 and game.model.snapshot()==grouped,"Copy preview retains separate room models without mutating originals")
	game.drop()
	check(game.model.rooms.size()==6 and not game.holding,"Place commits all copied rooms and returns to selection")
	game.undo()
	check(game.model.snapshot()==grouped,"Undo removes the whole group copy")
	game.select_hit(2); game.select_hit(2)
	game.editor_bar.get_child(0).pressed.emit()
	check(game.edit_action=="move" and not game.geometry.get_node("Room2").visible and not game.geometry.get_node("Room3").visible,"Explicit Move hides only the selected source floor")
	game.cancel_construction()
	check(game.model.snapshot()==grouped and game.geometry.get_node("Room2").visible,"Escape cancels a compound move")
	game.select_hit(2); game.select_hit(2)
	game.editor_bar.get_child(2).pressed.emit()
	check(game.model.rooms.size()==2 and not game.editor_bar.visible,"Delete removes the selected floor and clears selection")
	game.undo()
	game.select_debug_shape("cube")
	check(game.holding and game.selection_ids.is_empty() and not game.editor_bar.visible,"Palette explicitly enters placement and clears selection")
	game.cancel_construction()
	check(not game.holding,"Escape returns to the selection tool")
	game.free()
	print("Block City editor interaction: ",failures," failures")
	quit(1 if failures else 0)
