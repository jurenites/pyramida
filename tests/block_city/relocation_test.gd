extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,shape: String,x: int,z: int,y:=0) -> void:
	m.queue[0]={"shape":shape,"color":2}
	check(m.drop(x,z,0,y<0,y),"Place "+shape)
func run() -> void:
	var m=Model.new()
	place(m,"room_domino",0,0)
	var original: Dictionary=m.snapshot()
	var plan: Dictionary=m.relocation_plan(0,1,0,1,0)
	check(plan.ok and m.snapshot()==original,"Move preview is valid and never mutates live construction")
	check(m.relocate(0,1,0,1,0),"Move and rotate a placed room")
	check(m.rooms.size()==1 and m.rooms[0].cells==[[2,0,0],[1,0,0]],"Relocation transforms the existing cells without duplicating the room")
	check(m.rooms[0].normal==[0,0,-1] and m.rooms[0].door==[2,0,0],"Door transforms with the selected room")
	check(m.queue==original.queue and m.turn==original.turn and m.shape_uses==original.shape_uses,"Moving consumes no supply or turn")
	var loaded=Model.new()
	check(loaded.load_state(JSON.parse_string(JSON.stringify(m.snapshot()))) and loaded.rooms==m.rooms,"Moved room survives save/load")
	check(m.undo() and m.snapshot()==original,"One undo restores room, doorway and supply")
	place(m,"cube",0,0,1)
	var stacked: Dictionary=m.snapshot()
	plan=m.relocation_plan(0,2,0,0,0)
	check(not plan.ok and plan.issues.any(func(issue):return issue.cell==Vector3i(0,1,0)),"Moving a supporting room identifies the upper cell it would strand")
	check(not m.relocate(0,2,0,0,0) and m.snapshot()==stacked,"Invalid move preserves every room")
	check(not m.relocation_plan(1,0,0,0,0).ok,"Moving into another room is blocked")
	m=Model.new(); place(m,"room_domino",0,0)
	check(m.connect_power(Vector3i.ZERO,Vector3i.FORWARD),"Attach source cable")
	original=m.snapshot()
	check(m.relocate(0,1,0,0,0),"A wired room can move when its cable remains clear")
	check(m.cables[0].cell==[1,0,0] and m.powered_cells().has(Vector3i(1,0,0)),"Cable endpoint follows its room and remains powered")
	check(loaded.load_state(m.snapshot()),"Moved cable state remains valid")
	check(m.undo() and m.snapshot()==original,"Undo restores cable endpoint as part of the move")
	check(m.relocation_plan(0,0,0,2,0).ok and m.snapshot()==original,"Rotation preview allows cable crossings without changing the saved room")
	place(m,"cube",2,0)
	check(m.connect_power(Vector3i(2,0,0),Vector3i.FORWARD,{"cell":[0,0,0],"normal":[0,0,-1]}),"Add an outgoing daisy cable")
	check(m.relocate(0,1,0,0,0),"Moving a cable source updates a clear daisy chain")
	check(m.cables[1].source_cell==[1,0,0] and m.powered_cells().has(Vector3i(2,0,0)),"Outgoing source socket follows the moved room")
	check(loaded.load_state(m.snapshot()),"Relocated daisy chain remains saveable")
	m=Model.new(); place(m,"rectangle",0,0)
	m.queue[0]={"shape":"domino","color":0}
	check(m.drop(0,1,1,false,0,true),"Cut a room into fragments")
	var fragment: Dictionary=m.rooms[0].duplicate(true)
	plan=m.relocation_plan(0,0,0,0,1)
	check(plan.cells.size()==fragment.cells.size(),"Moving a carved room uses its exact surviving footprint")
	check(m.relocation_card(0).cells.size()==fragment.cells.size(),"No original full-size room is regenerated")
	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	game.set_process_unhandled_input(false)
	place(game.model,"room_domino",0,0)
	game.set_holding(false); game.refresh()
	game.camera.position=Vector3(1.5,12,5)
	game.camera.look_at(Vector3(1.5,0,1.5)); game.camera.size=7
	var click: Vector2=game.camera.unproject_position(Vector3(0.4,0.99,0.4))
	original=game.model.snapshot()
	game.click_world(click)
	check(game.selection_kind=="building" and not game.holding,"Click selects without moving")
	game.editor_action("move")
	check(game.edit_action=="move" and game.holding,"Move explicitly picks up the selection")
	check(game.preview.ok and game.preview.cells==[Vector3i(0,0,0),Vector3i(0,0,1)],"Selection initially stays at its exact built position")
	check(not game.geometry.get_node("Room0").visible and game.ghost.get_child_count()>0,"Only the selected preview replaces the source room visually")
	check(game.model.snapshot()==original,"Selecting preserves saved construction")
	game.rotate_shape(); game.rotate_shape(); game.rotate_shape(); game.rotate_shape()
	check(game.model.snapshot()==original and game.preview.ok,"Rotation is a reversible preview")
	game.cancel_construction()
	check(game.moving_id==-1 and not game.holding and game.model.snapshot()==original and game.geometry.get_node("Room0").visible,"Escape restores the source room without changing it")
	game.click_world(click)
	game.editor_action("move")
	var target: Vector2=game.camera.unproject_position(Vector3(1.4,0,1.4))
	game.position_anchor(target)
	check(game.preview.ok and game.preview.origin==Vector3i(1,0,0),"Selected room follows cursor on its floor")
	game.click_world(target)
	check(game.moving_id==-1 and not game.holding and game.model.rooms.size()==1 and game.model.rooms[0].cells==[[1,0,0],[1,0,1]],"Second click commits the move without duplication")
	check(game.model.queue==original.queue,"UI movement preserves the held supply")
	game.undo()
	check(game.model.snapshot()==original,"UI undo restores the full move transaction")
	check(not game.floor_up.visible and not game.floor_down.visible,"Floor controls hide after movement is committed or undone")
	game.free()
	print("Block City relocation: ",failures," failures")
	quit(1 if failures else 0)
