extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
const Card=preload("res://scripts/block_city/shape_card.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,shape: String,x: int,z: int,yaw:=0,y:=-100) -> void:
	m.queue[0]={"shape":shape,"color":0}
	check(m.drop(x,z,yaw,false,y),"Place "+shape+": "+m.error)
func run() -> void:
	var m=Model.new()
	place(m,"rectangle",0,0); place(m,"rectangle",0,0)
	var plan: Dictionary=m.landing({"shape":"domino","color":0},-1,1,0,false,1)
	check(plan.ok and plan.braces.size()==2,"A corridor attaches beside the wall with a brace under each cell")
	place(m,"domino",-1,1,0,1)
	place(m,"room_domino",-1,1,0,2)
	check(m.rooms[-1].cells==[[-1,2,1],[-1,2,2]],"A colored room can sit directly on the braced hall")
	place(m,"room_domino",-1,1,0,3)
	var saved: Dictionary=m.snapshot(); var loaded=Model.new()
	check(loaded.load_state(saved) and loaded.landing({"shape":"room_domino","color":0},-1,1,0,false,4).ok,"The hall's vertical support survives save/load")
	check(m.undo() and m.rooms.size()==4,"Undo removes only the last storey")
	check(not m.landing({"shape":"cube","color":0},-2,1,0,false,2).ok,"Side platforms cannot exceed the existing one-cell boundary")
	var chain=Model.new(); place(chain,"cube",0,0)
	place(chain,"cube",1,0,0,1)
	check(not chain.landing({"shape":"cube","color":0},2,0,0,false,2).ok,"A second beam cannot hang from a braced hall")
	check(chain.landing({"shape":"cube","color":0},1,0,0,false,2).ok,"The same hall can carry a vertical column")
	check(m.room_role({"shape":"room_domino"})=="room" and m.room_role({"shape":"domino"})=="hall","1×2 colored room is separate from the 1×2 corridor")

	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	game.set_holding(true)
	game.set_process_unhandled_input(false)
	place(game.model,"rectangle",0,0); place(game.model,"rectangle",0,0)
	game.refresh(); game.select_debug_shape("cube")
	var wall: Vector2=game.camera.unproject_position(Vector3(-0.02,1.5,1.5))
	check(game.position_anchor(wall) and game.preview.ok and game.preview.origin==Vector3i(-1,1,1),"Pointing at a side wall snaps a hall beside it at that level")
	check(game.preview.braces.size()==1,"Side-wall preview displays its diagonal beam")
	game.click_world(wall); game.refresh()
	check(game.model.rooms[-1].cells==[[-1,1,1]],"Click places the supported side hall")
	check(game.debug_palette.cards.has("room_domino") and game.debug_palette.cards.has("elevator"),"Palette contains room domino and elevator")
	check(not game.debug_palette.cards.has("flat_l") and not game.debug_palette.cards.has("flat_l_mirror"),"Both L shapes are hidden")
	var first: Dictionary=game.model.current().duplicate(true)
	game.select_debug_shape("flat_l")
	check(game.model.current()==first,"Retired L cannot be selected")
	var unit: float=game.debug_palette.cards.cube.cell_unit()
	for card in game.debug_palette.cards.values(): check(is_equal_approx(card.cell_unit(),unit),"Every palette icon uses the same projected unit cube")
	game.free()
	print("Block City platforms: ",failures," failures")
	quit(1 if failures else 0)
