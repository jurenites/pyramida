extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,x: int,y:=0) -> void:
	m.queue[0]={"shape":"cube","color":0}
	check(m.drop(x,0,0,false,y),"Place fixture")
func run() -> void:
	var m=Model.new()
	for x in 3: place(m,x)
	check(m.connect_power(Vector3i.ZERO,Vector3i.FORWARD),"Connect root wire")
	check(m.connect_power(Vector3i(1,0,0),Vector3i.FORWARD,{"cell":[0,0,0],"normal":[0,0,-1]}),"Connect middle wire")
	check(m.connect_power(Vector3i(2,0,0),Vector3i.FORWARD,{"cell":[1,0,0],"normal":[0,0,-1]}),"Connect last wire")
	var before: Dictionary=m.snapshot()
	check(m.removal_plan(1).ok and m.snapshot()==before,"Deletion preview leaves live state intact")
	check(m.remove_room(1) and m.rooms.size()==2 and m.rooms[1].cells==[[2,0,0]],"Remove only the chosen room and reindex survivors")
	check(m.cables.size()==1 and m.cables[0].cell==[0,0,0],"Remove incident and orphaned wires while preserving the root branch")
	check(m.queue==before.queue and m.turn==before.turn,"Deletion does not consume a supply piece or turn")
	var loaded=Model.new()
	check(loaded.load_state(m.snapshot()),"Deleted-room state remains saveable")
	check(m.undo() and m.snapshot()==before,"One undo restores room, wires, IDs and supply")
	m=Model.new(); place(m,0); place(m,0,1)
	before=m.snapshot()
	check(not m.remove_room(0) and m.snapshot()==before,"Deletion cannot leave an upper room floating")
	check(m.removal_plan(0).issues.any(func(issue):return issue.cell==Vector3i(0,1,0)),"Support failure points to the affected upper cube")
	check(m.remove_room(1) and m.remove_room(0) and m.rooms.is_empty(),"Top room and then final room can be removed")
	check(loaded.load_state(m.snapshot()),"Empty lot remains saveable")
	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	game.set_process_unhandled_input(false)
	place(game.model,0)
	game.set_holding(false); game.refresh()
	var key:=InputEventKey.new(); key.keycode=KEY_BACKSPACE; key.pressed=true
	game._input(key)
	check(game.model.rooms.size()==1,"Backspace with no selection does nothing")
	game.begin_move(0,game.camera.unproject_position(Vector3(0.4,0.99,0.4)))
	before=game.model.snapshot()
	game.rotate_shape()
	game._input(key)
	check(game.model.rooms.is_empty() and game.moving_id==-1 and not game.holding,"Backspace removes the selected source room during a move preview")
	check(game.preview.is_empty() and game.selected_route.is_empty() and not game.route_cost.visible,"Deletion clears selection and route visuals")
	game._input(key)
	check(game.model.rooms.is_empty(),"Repeated Backspace cannot delete an unselected room")
	game.undo()
	check(game.model.snapshot()==before,"Z restores the deletion exactly")
	game.begin_move(0,game.camera.unproject_position(Vector3(0.4,0.99,0.4)))
	game.toggle_menu(); game._unhandled_input(key)
	check(game.model.rooms.size()==1,"Open menu blocks deletion")
	game.free()
	print("Block City removal: ",failures," failures")
	quit(1 if failures else 0)
