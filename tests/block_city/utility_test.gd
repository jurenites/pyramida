extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
const Net=preload("res://scripts/block_city/utility_network.gd")
const Picker=preload("res://scripts/block_city/surface_picker.gd")
const Editor=preload("res://scripts/block_city/editor_selection.gd")
var failures:=0
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func _initialize() -> void:
	var m=Model.new()
	for x in 3:
		m.queue[0]={"shape":"cube","color":0}; check(m.drop(x,0,0,false,0),"Fixture")
	var a:=Net.node(Vector3i(0,0,0),Vector3i.FORWARD,"wall")
	var b:=Net.node(Vector3i(2,0,0),Vector3i.FORWARD,"wall")
	var graph:=Net.graph(m,0,100,false)
	var path:=Net.route(graph,a,b)
	check(path.size()==3,"Fast drag fills skipped tiles on the same face")
	check(Net.add(m,"power",path),"Commit one electrical stroke")
	check(not Net.add(m,"power",path),"Retracing does not duplicate edges or undo steps")
	check(m.powered_cells().is_empty(),"Drawn wires require a real supply")
	check(m.connect_power(Vector3i.ZERO,Vector3i.FORWARD),"Existing pole supplies the first room")
	check(m.powered_cells().size()==3,"Drawn wire spreads power through its connected rooms")
	var corner:=Net.node(Vector3i(2,0,0),Vector3i.RIGHT,"wall")
	check(Net.route(graph,b,corner).size()==2,"A drag turns a physical ninety-degree corner")
	var roof:=Net.node(Vector3i(2,0,0),Vector3i.UP,"roof")
	check(Net.route(graph,corner,roof).size()==2,"Wall route reaches the roof face")
	check(Net.add(m,"pipe",Net.route(graph,a,roof)),"Independent pipe network uses the same surfaces")
	check(Net.add(m,"vent",Net.route(graph,a,roof)),"Independent vent network uses the same surfaces")
	var state: Dictionary=m.snapshot(); var loaded=Model.new()
	check(loaded.load_state(JSON.parse_string(JSON.stringify(state))),"All three networks survive save and reload")
	check(loaded.utility_links==state.utility_links,"Network topology round trips exactly")
	check(Net.remove_at(m,"power",path[1]),"Backspace removes the hovered network tile")
	check(m.powered_cells().size()==1,"Removing the middle tile disconnects downstream supply")
	m.undo(); check(m.powered_cells().size()==3,"Undo restores a stroke edit atomically")
	var bad: Dictionary=state.duplicate(true); bad.utility_links[0].b.cell=[20,0,20]
	check(not loaded.load_state(bad) and loaded.snapshot()==state,"Invalid network saves never partially load")
	var count: int=m.utility_links.size()
	check(Editor.commit(m,Editor.removal(m,[2])) and m.utility_links.size()<count,"Room removal prunes its attached utility segments")
	m.undo(); check(m.utility_links.size()==count,"Undo room removal restores attached networks")
	var picked:=Picker.cast(m,Vector3(1.5,5,0.5),Vector3.DOWN)
	check(picked.cell==Vector3i(1,0,0) and picked.normal==Vector3i.UP and picked.surface=="roof","Ray resolves highest actual roof tile")
	picked=Picker.cast(m,Vector3(1.5,0.5,-5),Vector3.BACK)
	check(picked.cell==Vector3i(1,0,0) and picked.normal==Vector3i.FORWARD,"Ray distinguishes the visible side face")
	picked=Picker.cast(m,Vector3(1.5,5,0.5),Vector3.DOWN,1)
	check(picked.surface=="floor" and is_equal_approx(picked.point.y,0.08),"Removed roof does not intercept an interior floor hit")
	m.queue[0]={"shape":"cube","color":0}; m.drop(1,0,0,false,1)
	picked=Picker.cast(m,Vector3(1.5,5,0.5),Vector3.DOWN,1,0)
	check(picked.cell.y==0 and picked.surface=="floor","Manual floor selection ignores faded upper levels")
	picked=Picker.cast(m,Vector3(2.5,5,2.5),Vector3.DOWN,0,100,false,[],true)
	check(picked.surface=="ground" and picked.id==-1,"Owned empty ground maps to its tile")
	print("Block City surface utilities: ",failures," failures")
	quit(1 if failures else 0)
