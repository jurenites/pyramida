extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
const Editor=preload("res://scripts/block_city/editor_selection.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,shape: String,at: Vector3i,preferred:=0,carve:=false) -> void:
	m.queue[0]={"shape":shape,"color":1}
	check(m.drop(at.x,at.z,0,false,at.y,carve,preferred),"Place "+shape+" at "+str(at)+": "+m.error)
func run() -> void:
	var m=Model.new()
	place(m,"cube",Vector3i.ZERO)
	place(m,"cube",Vector3i(2,0,0))
	place(m,"cube",Vector3i(0,1,0))
	place(m,"cube",Vector3i(2,1,0))
	var left: int=m.rooms[0].building_id; var right: int=m.rooms[1].building_id
	check(left!=right and m.rooms[2].building_id==left and m.rooms[3].building_id==right,"Separate starts create identities; hall-only floors inherit their frame")
	place(m,"cube",Vector3i(1,0,0),right)
	check(m.rooms[4].building_id==right,"A bridging hall follows the selected neighboring building")
	check(Editor.building(m,0)==[0,2] and Editor.building(m,1)==[1,3,4],"Bridge never merges either existing building")
	check(Editor.path(m,0)[1].ids==[0] and Editor.path(m,1)[1].ids==[1,4],"Floor selection stays inside its building despite a walkable bridge")
	check(m.port_matches(m.rooms[0],Vector3i.ZERO,Vector3i.RIGHT) and m.port_matches(m.rooms[4],Vector3i(1,0,0),Vector3i.LEFT),"Building boundaries preserve physical hall connections")
	var before: Dictionary=m.snapshot()
	var loaded=Model.new()
	check(loaded.load_state(JSON.parse_string(JSON.stringify(before))) and loaded.snapshot()==before,"Identities survive JSON save/load")
	var plan:=Editor.plan(m,[2],Vector3i(0,2,0),0,true,"floor")
	check(plan.ok and Editor.commit(m,plan) and m.rooms[-1].building_id==left,"Copied upper floor remains in its source building")
	check(m.undo() and m.snapshot()==before,"Undo restores exact ownership after floor copy")
	plan=Editor.plan(m,[0,2],Vector3i(0,0,1),0,true,"building")
	check(plan.ok and Editor.commit(m,plan),"Can copy a whole building beside its original")
	var copy_owner: int=m.rooms[-1].building_id
	check(copy_owner!=left and copy_owner!=right and m.rooms[-2].building_id==copy_owner,"A whole-building copy has one new identity even when touching its source")
	check(Editor.building(m,0)==[0,2],"Adjacent copy does not expand original selection")
	m.undo()
	plan=Editor.plan(m,[0,2],Vector3i(1,0,1),1,false,"building")
	check(plan.ok and Editor.commit(m,plan) and m.rooms[0].building_id==left and m.rooms[2].building_id==left,"Moving and rotating a building preserves ownership")
	check(Editor.building(m,1)==[1,3,4],"Moving a building against another never merges it")
	m.undo()
	var group:=Editor.group_rooms(m,[0,1])
	check(group>0 and Editor.path(m,0)[0].kind=="group" and Editor.path(m,0)[2].ids==[0],"An explicit cross-building group retains per-building floor children")
	m.undo()
	var legacy: Dictionary=before.duplicate(true)
	for room in legacy.rooms: room.erase("building_id")
	check(loaded.load_state(legacy),"Older saves without ownership still load")
	check(loaded.rooms[0].building_id!=loaded.rooms[1].building_id,"Migration preserves separately started buildings even after their bridge was added")
	check(Editor.building(loaded,0)==[0,2,4] and Editor.building(loaded,1)==[1,3],"Legacy bridge gets a deterministic owner without combining buildings")
	for invalid in [0,-1,1.5,"1",null]:
		var bad: Dictionary=before.duplicate(true); bad.rooms[0].building_id=invalid
		var unchanged: Dictionary=loaded.snapshot()
		check(not loaded.load_state(bad) and loaded.snapshot()==unchanged,"Malformed ownership rejected without changing the model")
	var frame=Model.new()
	for level in 3: place(frame,"domino",Vector3i(0,level,0))
	place(frame,"domino",Vector3i(1,0,0))
	place(frame,"room_domino",Vector3i(1,1,0))
	check(frame.rooms.all(func(room):return room.building_id==frame.rooms[0].building_id),"Rooms inserted alongside a multi-storey hall frame belong to that frame")
	var cut=Model.new()
	place(cut,"rectangle",Vector3i.ZERO)
	var cut_owner: int=cut.rooms[0].building_id
	place(cut,"cube",Vector3i(0,0,1),0,true)
	check(cut.rooms.all(func(room):return room.building_id==cut_owner),"Hall carving and remaining room pieces preserve the original building")
	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	game.model.restore(before); game.set_holding(false); game.refresh()
	game.select_hit(1,false); game.select_hit(1,false)
	check(game.selection_kind=="floor" and game.selection_ids==[1,4],"Actual editor selects only the right building's floor")
	game.select_hit(3,false)
	check(game.selection_kind=="floor" and game.selection_ids==[3],"Sibling-floor click stays within the selected identity")
	game.select_hit(2,false)
	check(game.selection_kind=="building" and game.selection_ids==[0,2],"Clicking the other connected building starts its own hierarchy")
	game.set_holding(true)
	check(game.placement_building_id==left,"Picking up a palette piece remembers the selected building")
	game.set_holding(false)
	check(game.placement_building_id==0,"Putting the piece aside clears placement context")
	game.free()
	print("Block City building identity: ",failures," failures")
	quit(1 if failures else 0)
