extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
const Editor=preload("res://scripts/block_city/editor_selection.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,shape: String,x: int,z: int,y: int) -> void:
	m.queue[0]={"shape":shape,"color":1}
	check(m.drop(x,z,0,false,y),"Place fixture")
func run() -> void:
	var m=Model.new()
	for y in 2:
		place(m,"room_domino",0,0,y); place(m,"cube",1,0,y)
	var paths:=Editor.path(m,2)
	check(paths.map(func(p):return p.kind)==["building","floor","room"],"Default hierarchy is building, floor, room")
	check(paths[0].ids==[0,1,2,3] and paths[1].ids==[2,3],"Building and floor select all their rooms")
	var group:=Editor.group_rooms(m,[2,3])
	check(Editor.path(m,2).map(func(p):return p.kind)==["building","floor","group","room"],"Group inserts an intermediate hierarchy level")
	var nested:=Editor.group_rooms(m,[2,3])
	check(m.rooms[2].groups==[group,nested],"Grouping a unit preserves nested membership")
	var original: Dictionary=m.snapshot()
	var plan:=Editor.plan(m,[2,3],Vector3i(0,2,0),0,true)
	check(plan.ok and m.snapshot()==original,"Whole-floor copy previews above the original without mutating it")
	check(Editor.commit(m,plan) and m.rooms.size()==6,"Floor copy commits all rooms atomically")
	check(m.rooms[4].groups!=m.rooms[2].groups and m.rooms[4].groups==m.rooms[5].groups,"Copied groups are independent but keep their nesting")
	check(m.queue==original.queue and m.turn==original.turn,"Copying consumes no supply cards")
	var loaded=Model.new()
	check(loaded.load_state(JSON.parse_string(JSON.stringify(m.snapshot()))) and loaded.rooms==m.rooms,"Nested groups and copied floors round-trip through JSON")
	check(m.undo() and m.snapshot()==original,"One undo removes the complete copied floor")
	plan=Editor.plan(m,[0,1],Vector3i(1,0,0),0,false)
	check(not plan.ok and not Editor.commit(m,plan) and m.snapshot()==original,"Moving the base cannot strand upper rooms")
	plan=Editor.plan(m,[0,1,2,3],Vector3i(1,0,0),0,false)
	check(plan.ok and Editor.commit(m,plan),"Entire building can move together without transient support errors")
	check(m.rooms[0].cells==[[1,0,0],[1,0,1]] and m.rooms[2].cells==[[1,1,0],[1,1,1]],"Whole-building move preserves relative floors")
	m.undo()
	plan=Editor.plan(m,[0,1,2,3],Vector3i.ZERO,1,false)
	check(plan.ok and Editor.commit(m,plan),"Compound rotation transforms all rooms together")
	m.undo()
	check(not Editor.removal(m,[0,1]).ok,"Deleting a supporting floor is blocked")
	check(Editor.commit(m,Editor.removal(m,[2,3])) and m.rooms.size()==2,"Whole top floor deletes in one transaction")
	check(m.undo() and m.snapshot()==original,"Undo restores floor deletion and groups")
	check(Editor.commit(m,Editor.removal(m,[0,1,2,3])) and m.rooms.is_empty(),"Entire building deletes atomically")
	m.undo()
	var partial:=Editor.group_rooms(m,[1,2])
	check(m.rooms[2].groups==[partial] and m.rooms[3].groups==[group,nested],"Partial regrouping cannot create overlapping group branches")
	check(Editor.path(m,1).map(func(p):return p.kind)==["building","group","floor","room"],"A group spanning floors lives above its floor nodes")
	var wired=Model.new()
	place(wired,"cube",0,0,0); place(wired,"cube",1,0,0)
	check(wired.connect_power(Vector3i.ZERO,Vector3i.FORWARD,{},0),"Wire first room")
	check(wired.connect_power(Vector3i(1,0,0),Vector3i.FORWARD,{"cell":[0,0,0],"normal":[0,0,-1],"slot":0},1),"Wire its neighbor")
	Editor.group_rooms(wired,[0,1])
	var wired_before: Dictionary=wired.snapshot()
	plan=Editor.plan(wired,[0,1],Vector3i(0,0,1),0,false)
	check(plan.ok and Editor.commit(wired,plan),"Move an entire wired unit")
	check(wired.cables[0].cell==[0,0,1] and wired.cables[1].source_cell==[0,0,1] and wired.cables[1].cell==[1,0,1],"Incoming and outgoing cable endpoints follow all selected rooms")
	check(loaded.load_state(JSON.parse_string(JSON.stringify(wired.snapshot()))),"Moved wired group remains saveable")
	check(wired.undo() and wired.snapshot()==wired_before,"Undo restores both room and wire transformations")
	plan=Editor.plan(wired,[0,1],Vector3i(0,1,0),0,true)
	check(plan.ok and Editor.commit(wired,plan) and wired.cables==wired_before.cables and wired.powered_cells().size()==2,"Copies retain room geometry and groups but do not duplicate live utility feeds")
	var before_collision: Dictionary=wired.snapshot()
	plan=Editor.plan(wired,[0,1],Vector3i.ZERO,0,true)
	check(not plan.ok and not Editor.commit(wired,plan) and wired.snapshot()==before_collision,"Overlapping compound copies are rejected without partial writes")
	check(Editor.commit(wired,Editor.removal(wired,[0,1,2,3])) and wired.cables.is_empty(),"Deleting a whole wired building removes its utility branches")
	print("Block City editor: ",failures," failures")
	quit(1 if failures else 0)
