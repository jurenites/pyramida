extends SceneTree
const Model=preload("res://scripts/block_city/model.gd")
const Editor=preload("res://scripts/block_city/editor_selection.gd")
const Net=preload("res://scripts/block_city/utility_network.gd")
var failures:=0
func _initialize() -> void: call_deferred("run")
func check(ok: bool,message: String) -> void:
	if not ok: failures+=1; push_error(message)
func place(m,shape: String,at: Vector3i,yaw:=0) -> void:
	m.queue[0]={"shape":shape,"color":1}
	check(m.drop(at.x,at.z,yaw,at.y<0,at.y),"Place "+shape+str(at)+": "+m.error)
func run() -> void:
	var m=Model.new()
	for y in 3:
		for x in 2: place(m,"domino",Vector3i(x,y,0))
	var owner: int=m.rooms[0].building_id
	var upper: Array=m.rooms.slice(2).duplicate(true)
	check(m.connect_power(Vector3i.ZERO,Vector3i.FORWARD),"Supply before infill")
	var a:=Net.node(Vector3i.ZERO,Vector3i.FORWARD,"wall")
	var b:=Net.node(Vector3i(1,0,0),Vector3i.FORWARD,"wall")
	check(Net.add(m,"pipe",[a,b]),"Pipe on retained frame facade")
	m.queue[0]={"shape":"room_domino","color":2}
	var before: Dictionary=m.snapshot()
	var plan: Dictionary=m.landing(m.current(),0,0,1,false,0)
	check(plan.ok and plan.get("infill",false) and m.snapshot()==before,"Infill preview is valid and non-mutating")
	check(m.drop(0,0,1,false,0),"Room replaces only covered hall cells")
	check(m.occupied().size()==12 and m.rooms.size()==7,"Two half halls survive; occupancy and upper floors are retained")
	for original in upper:
		check(m.rooms.any(func(room):return room.cells==original.cells and room.shape==original.shape),"Upper room unchanged")
	check(m.rooms[0].cells==[[0,0,1]] and m.rooms[1].cells==[[1,0,1]],"Uncovered cells keep hall geometry")
	check(m.rooms.all(func(room):return room.building_id==owner),"Infill and remnants keep the same building identity")
	check(m.cables==before.cables and m.utility_links==before.utility_links,"Existing cable endpoints and supported pipe surfaces survive")
	check(Editor.validate(m).is_empty(),"All floors above remain structurally supported")
	var loaded=Model.new()
	check(loaded.load_state(JSON.parse_string(JSON.stringify(m.snapshot()))) and loaded.snapshot()==m.snapshot(),"Infilled structure round trips through JSON")
	check(m.undo() and m.snapshot()==before,"One undo restores exact frame and utilities")
	place(m,"room_domino",Vector3i(0,0,2),1)
	var source: int=m.rooms.size()-1
	plan=Editor.plan(m,[source],Vector3i.ZERO,0,false,"room")
	check(plan.ok and Editor.commit(m,plan),"Editor Move inserts a room into the frame")
	check(m.rooms[plan.ids[0]].cells==[[1,0,0],[0,0,0]] and m.rooms[plan.ids[0]].building_id==owner,"Renumbered selection points to the inserted room")
	check(Editor.validate(m).is_empty(),"Editor move retains frame support")
	m.undo()
	plan=Editor.plan(m,[source],Vector3i.ZERO,0,true,"room")
	check(plan.ok and Editor.commit(m,plan) and m.rooms.any(func(room):return room.cells==[[1,0,2],[0,0,2]]),"Copy fills a frame and retains its source")
	var stable: Dictionary=m.snapshot()
	check(not m.landing({"shape":"rectangle","color":1},0,0,0,false,0).ok and m.snapshot()==stable,"Infill cannot overwrite an existing ordinary room")
	var braced=Model.new()
	place(braced,"rectangle",Vector3i.ZERO); place(braced,"rectangle",Vector3i(0,1,0))
	place(braced,"domino",Vector3i(-1,1,1)); place(braced,"room_domino",Vector3i(-1,2,1))
	place(braced,"room_domino",Vector3i(-1,1,1))
	check(braced.rooms[-1].get("frame_cells",[]).size()==2 and Editor.validate(braced).is_empty(),"Infilled cantilever keeps the hall frame's beams and carries its upper room")
	check(loaded.load_state(braced.snapshot()) and Editor.validate(loaded).is_empty(),"Load-bearing infill survives reload")
	var invalid_frame: Dictionary=braced.snapshot(); invalid_frame.rooms[-1].frame_cells=[[99,0,99]]
	check(not loaded.load_state(invalid_frame),"Save cannot claim frame support outside the room footprint")
	var separate=Model.new()
	place(separate,"cube",Vector3i.ZERO); place(separate,"cube",Vector3i(2,0,0)); place(separate,"cube",Vector3i(1,0,0))
	plan=separate.landing({"shape":"bar","color":0},0,0,1,false,0)
	check(not plan.ok and plan.issues.any(func(issue):return issue.kind=="building"),"One room cannot silently absorb hall frames from two building identities")
	var game=load("res://scripts/block_city/game.gd").new()
	game.auto_save=false; game.restore_last=false; root.add_child(game)
	game.model.restore(before); game.view_mode=1; game.select_debug_shape("room_domino"); game.select_floor(0)
	game.anchor=Vector2i.ZERO; game.snap_y=0; game.yaw=1; game.refresh()
	check(game.preview.ok and game.preview.get("infill",false),"Forced-floor construction exposes a valid room-in-frame preview beneath upper floors")
	game.drop()
	check(game.model.rooms[-1].shape=="room_domino" and game.model.occupied().size()==12,"Construction click/Space commits room-in-frame occupancy")
	game.set_holding(false); game.select_hit(game.model.rooms.size()-1); game.select_hit(game.model.rooms.size()-1); game.select_hit(game.model.rooms.size()-1)
	game.editor_action("move"); game.anchor=Vector2i(0,1); game.snap_y=0; game.refresh_preview()
	check(game.preview.get("frame_infill",false),"Editor previews renumbered hall remnants without stale room indexing")
	game.free()
	var aim=load("res://scripts/block_city/game.gd").new()
	aim.auto_save=false; aim.restore_last=false; root.add_child(aim)
	place(aim.model,"domino",Vector3i.ZERO)
	aim.view_mode=1; aim.select_debug_shape("room_domino"); aim.refresh()
	var floor_point: Vector2=aim.camera.unproject_position(Vector3(0.5,0.08,0.5))
	check(aim.position_anchor(floor_point) and aim.preview.ok and aim.preview.origin.y==0 and aim.preview.get("infill",false),"Pointing at an exposed hall floor fills its current storey")
	aim.view_mode=0; aim.reset_placement_aim(); aim.refresh()
	var roof_point: Vector2=aim.camera.unproject_position(Vector3(0.5,1,0.5))
	check(aim.position_anchor(roof_point) and aim.preview.origin.y==1 and not aim.preview.get("infill",false),"Pointing at a roof still stacks on top")
	aim.free()
	print("Block City hall infill: ",failures," failures")
	quit(1 if failures else 0)
