const SELECTION_COLOR := Color("FFC471")
const PADDING_UNIT := POINT
const GAP_UNIT := POINT
const PANEL_PADDING_X := 8 * POINT
const PANEL_PADDING_Y := 5 * POINT
# Compatibility names for existing widgets, measured in logical points.
const OUTLINE_PIXELS := LINE_WIDTH
const BUILDING_ICON_STROKE_PIXELS := LINE_WIDTH
