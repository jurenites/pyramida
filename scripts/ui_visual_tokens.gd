## Shared point-based sizing for runtime and editor UI.
## One point is one logical UI pixel; DisplayScale applies monitor density once.
## Component-specific geometry remains beside the component that renders it.

const POINT := 1
const GAME_ICON_SCALE := 1.0
const GAME_ICON_SIZE := 34 * POINT * GAME_ICON_SCALE
const GAME_TOOLBAR_BUTTON_SIZE := 40 * POINT * GAME_ICON_SCALE
